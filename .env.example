# ---------------------------------------------------------------------------
# AirHealth Engineer: environment variables
# Copy to .env.local for local dev; set the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit real values.
# ---------------------------------------------------------------------------

# --- Meta Model API (Muse Spark) -- REQUIRED ---------------------------------
# Create a key in the Model API dashboard (API keys tab). Keys start with "LLM_".
# Docs: https://dev.meta.ai/docs/authentication
MODEL_API_KEY=
# Documented base URL (https://dev.meta.ai/docs/api-reference). Override only if Meta changes it.
META_API_BASE_URL=https://api.meta.ai/v1
# Must be a Muse Spark model id: muse-spark-1.3 (latest), muse-spark-1.2, muse-spark-1.1, or a -contributor variant.
# https://dev.meta.ai/docs/models
META_MODEL_ID=muse-spark-1.3
# Optional: minimal | low | medium | high | xhigh  ("none" is rejected by the API). Leave empty for model default.
META_REASONING_EFFORT=
# Allow several tool calls per model turn (API default is true; this app defaults to false).
META_PARALLEL_TOOL_CALLS=false
META_TIMEOUT_MS=55000
META_MAX_RETRIES=3

# --- Agent loop ---------------------------------------------------------------
AGENT_MAX_ITERATIONS=8
# Wall-clock budget for one run. Keep below your Vercel function maxDuration (300 s in this repo).
AGENT_RUN_BUDGET_MS=270000
TOOL_TIMEOUT_MS=20000
APPROVAL_TTL_MINUTES=60

# --- Air quality -------------------------------------------------------------
# OpenAQ v3 key: register at https://explore.openaq.org/register then copy the key from your account settings.
# https://docs.openaq.org/using-the-api/api-key
OPENAQ_API_KEY=
OPENAQ_BASE_URL=https://api.openaq.org/v3
# If no OpenAQ station is in range (or no key is set), use Open-Meteo/CAMS modelled data (clearly labelled as modelled).
AIR_QUALITY_MODEL_FALLBACK=true
# Keyless geocoder (Open-Meteo) for city names worldwide.
GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1
# Keyless OpenStreetMap Nominatim: postcodes/addresses and reverse geocoding of shared coordinates.
# Public instance policy: <= 1 req/s with an identifying User-Agent (the app caches results).
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Open-Meteo forecast endpoint, used only to look up the timezone for coordinates.
TIMEZONE_BASE_URL=https://api.open-meteo.com/v1
AIR_QUALITY_MODEL_BASE_URL=https://air-quality-api.open-meteo.com/v1

# --- Devices -----------------------------------------------------------------
# sandbox (default: simulated, state persisted) | homeassistant | webhook
DEVICE_ADAPTER=sandbox
# Home Assistant REST API: https://developers.home-assistant.io/docs/api/rest/
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
# Generic signed webhook (body signed with HMAC-SHA256 in X-AirHealth-Signature)
DEVICE_WEBHOOK_URL=
DEVICE_WEBHOOK_SECRET=

# --- Storage -----------------------------------------------------------------
# Upstash Redis REST credentials (or the Vercel KV / Upstash Marketplace names below).
# Without these, an in-memory store is used: fine locally, NOT durable on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
STORAGE_KEY_PREFIX=ahe
STATE_TTL_DAYS=30

# --- API protection ----------------------------------------------------------
# If set, every route except GET /api/health requires "Authorization: Bearer <token>".
API_AUTH_TOKEN=

# --- Logging -----------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info

# ----- Background monitoring ---------------------------------------------------
# Vercel Cron calls GET /api/cron/monitor with "Authorization: Bearer $CRON_SECRET".
# Generate one with: openssl rand -hex 32. The cron route refuses to run without it.
CRON_SECRET=
# Minimum minutes between re-checks of the same conversation (1-1440).
MONITOR_MIN_INTERVAL_MINUTES=10
# Max conversations re-checked per cron invocation (1-200).
MONITOR_MAX_SESSIONS_PER_RUN=20

# --- Site URL (optional) ---
# Absolute URL used for Open Graph image links. On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used automatically.
NEXT_PUBLIC_SITE_URL=
